region = "us-east-1"
availability_zones = ["us-east-1a", "us-east-1b"]
name = "portfolio-two-tier"
# No passwords: RDS generates and stores its password in Secrets Manager.
# For a production deployment enable Multi-AZ, deletion protection and final snapshots.
# db_multi_az = true
# deletion_protection = true
# skip_final_snapshot = false
# final_snapshot_identifier = "portfolio-two-tier-final-YYYYMMDD"
# Optional: use existing, validated ACM certificates and Route53 zone.
# domain_name = "lab.example.com"
# hosted_zone_id = "YOUR_ZONE_ID"
# cloudfront_certificate_arn = "YOUR_US_EAST_1_CERTIFICATE_ARN"
# origin_domain_name = "origin.example.com"
# alb_certificate_arn = "YOUR_REGIONAL_CERTIFICATE_ARN"
